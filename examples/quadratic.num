# quadratic.num - solve x^2 - 5x + 6 = 0 with the quadratic formula.
#
# Numbered variables hold the coefficients, the discriminant, -b, and 2a;
# sqrt is opcode 22. The roots of the polynomial are 3 and 2.

0 5 - 1 &     # |1 = b = -5
1.0 2 &       # |2 = a = 1
6.0 3 &       # |3 = c = 6

# |4 = discriminant = b*b - 4ac
|1 |1 * |2 |3 * 4 * - 4 &
# |5 = -b
0 |1 - 5 &
# |6 = 2a
|2 2 * 6 &

"root 1: " |5 |4 22 + |6 / |
"root 2: " |5 |4 22 - |6 / |
